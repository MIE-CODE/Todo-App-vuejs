# Public (safe to expose to the browser)
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only
NUXT_SESSION_SECRET=replace-with-a-long-random-string
# Local path only. On Vercel the app automatically uses /tmp/<filename>
# because the deploy filesystem is read-only.
NUXT_DATABASE_PATH=.data/app.sqlite

# Billing is a local sandbox (no Stripe keys). Test cards:
#   Success: 4242 4242 4242 4242
#   Decline: 4000 0000 0000 0002
# Premium Focus Orbit unlocks only after payment status is confirmed.
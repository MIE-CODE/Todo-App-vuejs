{
  "name": "taskflow",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "lint:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "prepare:husky": "husky",
    "prepare": "husky"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.117",
    "@iconify-json/simple-icons": "^1.2.90",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/ui": "^4.10.0",
    "@pinia/nuxt": "^1.0.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/nuxt": "^14.3.0",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^6.0.0",
    "nuxt": "^4.4.8",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.2",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^3.19.2",
    "@playwright/test": "^1.54.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.15",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "drizzle-kit": "^0.31.4",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.5",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "playwright": "^1.54.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.7"
  },
  "packageManager": "pnpm@11.13.1",
  "description": "TaskFlow — a focused, self-contained Nuxt 4 todo product (also a teaching codebase for Vue/Nuxt).",
  "lint-staged": {
    "*.{js,ts,mjs,vue,json,md,css,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,ts,mjs,vue}": [
      "eslint --fix"
    ]
  }
}
